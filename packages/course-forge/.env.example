# Course Forge 本地配置：复制为 .env 并填入真实值（同目录 .env 已进 .gitignore，勿提交 key）。
# 只填充未设置的项——已存在的进程环境变量优先于本文件。

# —— 推荐：阿里云百炼 qwen-plus（OpenAI 兼容端点）——
FORGE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FORGE_LLM_MODEL=qwen3.8-flash
FORGE_LLM_API_KEY=sk-换成你的百炼Key
# 非 ollama 服务必须留空本行：ollama 专用的 reasoning_effort="none" 会被 DashScope 拒绝
FORGE_LLM_REASONING_EFFORT=
# 思考开关：qwen3.8-flash 等新模型默认开思考（思考吃 max_tokens 且无正文进度，看似卡死），云端建议关闭；ollama 不认识该字段时留空本行即可
FORGE_LLM_ENABLE_THINKING=false
# 单次 LLM 输出上限（qwen-plus 上限 32768，250 词分块用 16000 足够）
FORGE_LLM_MAX_TOKENS=16000
# 单次调用携带的最大转写词数：一个分块生成一门课
FORGE_LLM_MAX_WORDS=250

# —— 切回本地 ollama（小模型质量不足，仅应急）：注释掉上面几行，改用下面 ——
# FORGE_LLM_BASE_URL=http://localhost:11434/v1
# FORGE_LLM_MODEL=qwen3:4b
# FORGE_LLM_API_KEY=ollama
# FORGE_LLM_REASONING_EFFORT=none
