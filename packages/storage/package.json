{
  "name": "@earthworm/storage",
  "version": "0.0.0",
  "private": true,
  "description": "S3 兼容对象存储封装：dev 指向 MinIO，prod 指向阿里云 OSS（S3 协议）",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsup": "^8.0.1",
    "typescript": "5.5.4",
    "vitest": "^1.2.2"
  }
}
