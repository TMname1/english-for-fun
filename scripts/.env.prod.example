# 后端一键部署脚本（scripts/backend-deploy.ts）所需变量。
# 复制为 scripts/.env.prod 后填写（.env.prod 已被 gitignore，绝不提交）。
# 运行：pnpm deploy:serve
# 说明见 README.deploy.md。⚠️ 运行前务必已按 README.backend.md 手动成功部署过一次。

# —— 阿里云容器镜像服务 ACR ——
# 推送/拉取镜像的仓库地址；个人实例默认杭州，如换地域改成对应 registry 域名
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
# ACR 命名空间（控制台「命名空间」里创建的那个）
ACR_NAMESPACE=
# 阿里云账号全名（登录用户名，不是 AccessKey；控制台 ACR 基本信息里能看到）
ACR_USERNAME=
# ACR 访问密码（专用「访问凭证」密码，不是阿里云登录密码）
ACR_PASSWORD=
# 镜像仓库名，与第 1 步建的私有仓库一致
IMAGE_NAME=earthworm-api
# tag 前缀；实际推送 tag 为 <前缀>-<git短哈希>，例如 v1-9f3a2c1
IMAGE_TAG_PREFIX=v1

# —— 云服务器 SSH（脚本用用户名+密码登录执行第 5-9 步）——
# ECS 公网 IP 或域名
SSH_HOST=
# SSH 端口，默认 22
SSH_PORT=22
# 登录用户名（如 root 或你的普通用户）
SSH_USER=
# 登录密码
SSH_PASSWORD=
# 服务器上部署目录（compose 与 env 文件所在处）
REMOTE_DIR=/opt/earthworm
