# 生产环境模板：复制为 apps/client/.env.prod
# 生产构建链 pnpm build:client → nuxt generate --dotenv .env.prod 读取本文件
# 值会打包进浏览器产物，禁放任何密钥，只放公开配置

# 后端 API 基址（前端所有请求的 baseURL）
# 注意：换域名需同步改 apps/api/src/main.ts 的 CORS 白名单正则
API_BASE="https://你的生产API地址"
# 生产建议关闭「导入视频」入口；非 0 均视为开启
ALLOW_FORGE=0
# Microsoft Clarity 统计 tag id，仅 NODE_ENV=production 构建时注入，按需填写
# CLARITY=