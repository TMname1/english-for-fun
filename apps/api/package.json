  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=prod node dist/src/main",
    "start:prod:pm": "cross-env NODE_ENV=prod pm2 start ecosystem.config.js",
    "test": "tsx scripts/with-testdb.ts",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.config.ts",
    "test:e2e": "cross-env NODE_ENV=test jest --config jest.config.e2e.ts",
    "test:cov": "jest --coverage",
    "forge": "tsx src/forge/core/cli.ts forge",
    "forge:import": "tsx src/forge/core/cli.ts import",
    "db:push": "drizzle-kit push",
    "db:push:test": "drizzle-kit push --config=drizzle.config.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "dev:langsmith": "langgraphjs dev --config . --no-reload"
  },
