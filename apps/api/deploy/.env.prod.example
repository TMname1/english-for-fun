# api 运行时变量：复制为 .env.prod 并填写（chmod 600，勿提交）
# 由 compose env_file 注入容器；NODE_ENV=prod / PORT=3001 镜像已内置，无需在此设置
# 各变量详解见仓库根 README.env.prod.md

DATABASE_URL="postgres://earthworm:换成与.env中POSTGRES_PASSWORD一致的密码@pg:5432/earthworm"
# 登录 Cookie 的 HMAC 签名密钥，用 openssl rand -hex 32 生成；泄露可伪造登录凭证
SECRET="换成强随机串"
# 单用户登录凭证（详见根目录 README.login.md）
AUTH_USERNAME="admin"
AUTH_PASSWORD="换成强密码"
# Optional: 访问 Edge TTS 的 HTTP 代理，服务器能直连就留空
TTS_PROXY_URL=""

# —— 对象存储：阿里云 OSS（S3 协议），生产必须显式填写，无默认值兜底 ——
# 端点/桶/RAM 授权步骤见 README.env.prod.md；必须用公网端点（预签名 URL 要给浏览器访问）
S3_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
S3_REGION="oss-cn-hangzhou"
S3_ACCESS_KEY_ID="RAM子账号AccessKeyID"
S3_SECRET_ACCESS_KEY="RAM子账号AccessKeySecret"
S3_BUCKET="你的桶名"
# 阿里云 OSS 必须 false（虚拟主机风格），填 true 会 404/签名错误
S3_FORCE_PATH_STYLE="false"
# 预签名 URL 有效期（秒），默认 21600 = 6 小时
S3_PRESIGN_EXPIRES_SECONDS="21600"
# 浏览器直传（预签名 PUT）有效期（秒），默认 600 = 10 分钟；拿到后要立刻上传
S3_PRESIGN_PUT_EXPIRES_SECONDS="600"

# —— Course Forge（视频/音频 → 课程包流水线；子进程自动继承本文件变量）——
# ASR：阿里云百炼 DashScope Qwen-Audio-ASR（同步调用，词级时间戳）
FORGE_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
FORGE_ASR_MODEL=qwen-audio-3.1-asr-flash
FORGE_ASR_API_KEY=sk-换成你的百炼Key
# 单次转写超时（毫秒）。转写子图按 ≤180s 切块，默认 5 分钟；低于 240000 高峰期易误判超时
FORGE_ASR_TIMEOUT_MS=300000

# —— 转写子图：captioner 句级时间戳 → 切块 → asr-flash 词级 ——
# captioner 是异步任务接口（提交 → 轮询 → 下载），必须能访问 workspace 域名。
# 留空会回退 FORGE_ASR_BASE_URL 的 origin 并打警告；公网 dashscope 未开通该模型时务必显式填写
FORGE_CAPTIONER_BASE_URL=https://ws-你的workspace.cn-beijing.maas.aliyuncs.com
FORGE_CAPTIONER_MODEL=qwen-audio-3.1-captioner
# 留空回退 FORGE_ASR_API_KEY（同一 workspace 通常共用一把）
FORGE_CAPTIONER_API_KEY=
FORGE_CAPTIONER_TIMEOUT_MS=60000
FORGE_CAPTIONER_POLL_INTERVAL_MS=3000
# 轮询总超时（毫秒），必须小于 service job 超时（30 分钟）
FORGE_CAPTIONER_POLL_TIMEOUT_MS=600000
# 块上限（秒，必须 <300）/ 块前后 padding（毫秒）/ 块级 ASR 并发
FORGE_ASR_CHUNK_SECONDS=180
FORGE_ASR_CHUNK_PAD_MS=200
FORGE_ASR_CONCURRENCY=3
# 1 = 成功后也保留 .work（块音频 + 逐块结果），排查时间对齐问题时用
FORGE_KEEP_WORK=0

FORGE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 句子分析（结构化组装链）模型
FORGE_LLM_MODEL=tongyi-xiaomi-analysis-flash
# 预处理（拆句）模型，共用上面的 base URL / API Key
FORGE_PREPROCESS_MODEL=qwen3.8-flash
FORGE_LLM_API_KEY=sk-换成你的百炼Key
# 非 ollama 服务必须留空：ollama 专用 reasoning_effort="none" 会被 DashScope 拒绝
FORGE_LLM_REASONING_EFFORT=
# 云端建议关闭思考（思考吃 max_tokens 且看似卡死）
FORGE_LLM_ENABLE_THINKING=false
FORGE_LLM_MAX_TOKENS=16000
FORGE_LLM_CONCURRENCY=10
# forge CLI 导入课程时的目标 API 地址（Web 端流水线不需要）
FORGE_API_URL=https://api.你的域名
# langfuse 追踪：线上不自托管（2核2G 跑不动完整栈），直接出站写 Langfuse Cloud
# 只需容器能出站访问 443，安全组入方向不用开任何端口
LANGFUSE_TRACING=1
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-换成你的
LANGFUSE_SECRET_KEY=sk-lf-换成你的
LANGFUSE_TRACING_ENVIRONMENT=production
