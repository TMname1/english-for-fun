# 生产环境模板：复制为 apps/api/.env.prod，启动时进程环境设 NODE_ENV=prod
# 详见根目录 README.env.prod.md；登录凭证说明见 README.login.md

DATABASE_URL="postgres://用户:密码@生产数据库地址:5432/earthworm"
# 登录 Cookie 的 HMAC 签名密钥：务必换成强随机串，不要沿用 dev 示例值；修改会使已发放凭证失效
SECRET="换成一个强随机字符串"
# 单用户登录凭证（详见根目录 README.login.md）
AUTH_USERNAME="生产用户名"
AUTH_PASSWORD="换成强密码"
# API 监听端口，默认 3001（pm2 / 反代上游端口）
# PORT=3001
# 访问 Edge TTS 的 HTTP 代理；服务器能直连就留空
TTS_PROXY_URL=""

# —— 对象存储：阿里云 OSS（S3 兼容协议）——
# 生产没有 dev MinIO 默认值兜底，S3_* 必须显式填写
# 端点填公网 S3 兼容端点（预签名 URL 要给浏览器直连，不能用 -internal 内网端点）
S3_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
S3_REGION="oss-cn-hangzhou"
# RAM 子账号 AccessKey（最小权限授权见 README.env.prod.md），绝不进前端或仓库
S3_ACCESS_KEY_ID="RAM子账号AccessKeyID"
S3_SECRET_ACCESS_KEY="RAM子账号AccessKeySecret"
S3_BUCKET="你的桶名"
# 阿里云 OSS 必须 false（虚拟主机风格）；填 true 会 404/签名错误
S3_FORCE_PATH_STYLE="false"
# 预签名 URL 有效期（秒），默认 21600 = 6 小时
S3_PRESIGN_EXPIRES_SECONDS="21600"

# —— Course Forge（视频/音频 → 课程包流水线）——
# 后端发起的子进程自动继承 API 进程环境；服务器上手动跑 CLI 时读本文件
# ASR / LLM 配置同 dev（见 README.env.dev.md 第三节），Key 只放本文件
FORGE_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
FORGE_ASR_MODEL=qwen-audio-3.1-asr-flash
FORGE_ASR_API_KEY=sk-换成你的百炼Key
FORGE_ASR_TIMEOUT_MS=180000

FORGE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FORGE_LLM_MODEL=tongyi-xiaomi-analysis-flash
FORGE_PREPROCESS_MODEL=qwen3.8-flash
FORGE_LLM_API_KEY=sk-换成你的百炼Key
# 非 ollama 服务必须留空本行（reasoning_effort 会被 DashScope 拒绝）
FORGE_LLM_REASONING_EFFORT=
# 云端默认开思考的模型建议关闭，否则思考吃光 max_tokens 看似卡死
FORGE_LLM_ENABLE_THINKING=false
FORGE_LLM_MAX_TOKENS=16000
FORGE_LLM_CONCURRENCY=10
FORGE_LLM_PREFLIGHT=1
FORGE_LLM_VRAM_STRICT=1
FORGE_LLM_VRAM_MARGIN_MB=512
# 课程导入目标：生产 API 地址
FORGE_API_URL="https://你的生产API地址"