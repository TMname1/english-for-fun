DATABASE_URL="postgres://postgres:password@localhost:5433/earthworm"
# 登录 Cookie 的签名密钥，泄露或修改会使已发放的登录凭证失效
SECRET="换成一个长随机字符串"
# 单用户登录凭证（详见根目录 README.login.md）
AUTH_USERNAME="admin"
AUTH_PASSWORD="change-me"
# NODE_ENV 在进程环境中设置：留空读本文件；test 读 .env.test；prod 读 .env.prod
# API 监听端口，默认 3001
# PORT=3001
# Optional: http proxy used to reach the Edge TTS service, e.g. http://127.0.0.1:10809
TTS_PROXY_URL=""

# —— 对象存储（S3 协议）：dev 用 docker compose 的 MinIO，prod 用阿里云 OSS ——
# 详见根目录 README.env.dev.md 与 README.env.prod.md。以下默认值即 dev MinIO，可不填。
# prod 示例：
#   S3_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
#   S3_REGION="oss-cn-hangzhou"
#   S3_FORCE_PATH_STYLE="false"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="earthworm"
# MinIO 必须 true（path-style）；阿里云 OSS 必须 false（虚拟主机风格）
S3_FORCE_PATH_STYLE="true"
# 预签名 URL 有效期（秒），默认 21600 = 6 小时
S3_PRESIGN_EXPIRES_SECONDS="21600"
# —— Course Forge（视频/音频 → 课程包流水线；子进程自动继承，CLI 直跑时读本文件）——
# —— ASR：阿里云百炼 DashScope Qwen-Audio-ASR（非实时 / 同步调用，词级时间戳固定返回）——
FORGE_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
FORGE_ASR_MODEL=qwen-audio-3.1-asr-flash
FORGE_ASR_API_KEY=sk-换成你的百炼Key
# 单次转写请求超时（毫秒）；同步等待完整结果。默认 5 分钟（转写子图按 ≤180s 切块）
FORGE_ASR_TIMEOUT_MS=300000
# 注意：flash 同步版建议单段音频 ≤5 分钟；转写子图会把长音频按句边界切成 ≤180s 的块

# —— 转写子图：captioner 句级时间戳 + 切块 + asr-flash 词级 ——
# captioner 是异步任务接口（提交 → 轮询 → 下载结果）。留空则回退 FORGE_ASR_BASE_URL 的 origin
FORGE_CAPTIONER_BASE_URL=
FORGE_CAPTIONER_MODEL=qwen-audio-3.1-captioner
# 留空则回退 FORGE_ASR_API_KEY
FORGE_CAPTIONER_API_KEY=
FORGE_CAPTIONER_TIMEOUT_MS=60000
FORGE_CAPTIONER_POLL_INTERVAL_MS=3000
# 轮询总超时（毫秒），必须小于 job 超时 30 分钟
FORGE_CAPTIONER_POLL_TIMEOUT_MS=600000
# 块上限（秒，必须 <300）、块前后 padding（毫秒）、块级 ASR 并发
FORGE_ASR_CHUNK_SECONDS=180
FORGE_ASR_CHUNK_PAD_MS=200
FORGE_ASR_CONCURRENCY=3
# 1 = 转写成功后也保留 .work（块音频与逐块结果），排查时间对齐问题用
FORGE_KEEP_WORK=0

FORGE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 句子分析（结构化组装链）模型
FORGE_LLM_MODEL=tongyi-xiaomi-analysis-flash
# 预处理（拆句）模型；与句子分析模型分开配置，共用上面的 base URL / API Key
FORGE_PREPROCESS_MODEL=qwen3.8-flash
FORGE_LLM_API_KEY=sk-换成你的百炼Key
# 非 ollama 服务必须留空本行：ollama 专用的 reasoning_effort="none" 会被 DashScope 拒绝
FORGE_LLM_REASONING_EFFORT=
# 思考开关：qwen3.8-flash 等新模型默认开思考（思考吃 max_tokens 且无正文进度，看似卡死），云端建议关闭；ollama 不认识该字段时留空本行即可
FORGE_LLM_ENABLE_THINKING=false
# 单次 LLM 输出上限（一句一调用，单条组装链很小，留足余量即可）
FORGE_LLM_MAX_TOKENS=16000
# 一句一调用的并发上限：同时发起多少个句子的模型调用
FORGE_LLM_CONCURRENCY=10
# 调用前是否预检（服务连通 / 模型存在 / 显存余量），0 跳过
FORGE_LLM_PREFLIGHT=1
# 显存估算不足时是否直接拦停，0 仅警告（接受 CPU 卸载慢跑）；仅本地 ollama/GPU 场景相关
FORGE_LLM_VRAM_STRICT=1
# 显存估算余量（MB，KV cache + CUDA 上下文）
FORGE_LLM_VRAM_MARGIN_MB=512
# 课程导入目标 API 地址（forge:import 用），默认 http://localhost:3001
FORGE_API_URL=http://localhost:3001
# 编排层：graph（LangGraph 图，默认）/ legacy（重构前的命令式实现，出问题时的回滚开关）
FORGE_ORCHESTRATOR=graph
# 每个任务保留的 checkpoint 份数（resolve 续跑依赖最近的中断态，勿小于 2）
FORGE_GRAPH_CHECKPOINT_KEEP=8

# langsmith
# 上报节点/LLM 调用到 LangSmith 才需要下面这些；本地调图（pnpm dev:langsmith）不依赖它们
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=development

# langfuse（LangGraph 图 + 节点 + 每次 LLM 调用的追踪）
# 本地自托管栈在根 docker-compose.yml 里，随 pnpm docker:start 一起启动
# 界面 http://localhost:3002，默认账号 dev@local.test / langfuse1234
# 下面这对 key 就是 compose 里 LANGFUSE_INIT_PROJECT_* 的默认值；两个都填了才启用，
# 任一留空则整条追踪链路自动禁用（fail-open，不会影响流水线）
LANGFUSE_TRACING=1
LANGFUSE_BASE_URL=http://localhost:3002
LANGFUSE_PUBLIC_KEY=pk-lf-11111111-1111-1111-1111-111111111111
LANGFUSE_SECRET_KEY=sk-lf-22222222-2222-2222-2222-222222222222
LANGFUSE_TRACING_ENVIRONMENT=development

# langfuse prompt management（提示词托管）：复用上面的 PUBLIC/SECRET/BASE_URL
# 运行时按 label 从 Langfuse 拉取提示词，进程内缓存 TTL 内不重复拉；拉取失败自动回退代码里的本地常量
# 配好 key 即默认开；LANGFUSE_PROMPTS=0 只关提示词托管（不影响追踪）
LANGFUSE_PROMPTS=1
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_MS=60000
# 两个提示词在 Langfuse 中的名字，与 Langfuse 界面里创建的 Prompt name 必须一致
FORGE_PROMPT_SENTENCE_NAME=forge-sentence-chain
FORGE_PROMPT_PREPROCESS_NAME=forge-preprocess-split
