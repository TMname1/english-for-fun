DATABASE_URL="postgres://postgres:password@localhost:5433/earthworm"
# 登录 Cookie 的签名密钥，泄露或修改会使已发放的登录凭证失效
SECRET="sjldk92#sd903mnc./xklsjdf9sdfj"
# 单用户登录凭证（详见根目录 README.login.md）
AUTH_USERNAME="admin"
AUTH_PASSWORD="change-me"
# Optional: http proxy used to reach the Edge TTS service, e.g. http://127.0.0.1:10809
TTS_PROXY_URL=""

# —— 对象存储（S3 协议）：dev 用 docker compose 的 MinIO，prod 用阿里云 OSS ——
# 详见根目录 README.dev.env.md 与 README.prod.env.md。以下默认值即 dev MinIO，可不填。
# prod 示例：
#   S3_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
#   S3_REGION="oss-cn-hangzhou"
#   S3_FORCE_PATH_STYLE="false"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="earthworm"
# MinIO 必须 true（path-style）；阿里云 OSS 必须 false（虚拟主机风格）
S3_FORCE_PATH_STYLE="true"
# 预签名 URL 有效期（秒），默认 21600 = 6 小时
S3_PRESIGN_EXPIRES_SECONDS="21600"
# —— Course Forge（视频/音频 → 课程包流水线；子进程自动继承，CLI 直跑时读本文件）——
# —— ASR：阿里云百炼 DashScope Qwen-Audio-ASR（非实时 / 同步调用，词级时间戳固定返回）——
FORGE_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
FORGE_ASR_MODEL=qwen-audio-3.1-asr-flash
FORGE_ASR_API_KEY=sk-换成你的百炼Key
# 单次转写请求超时（毫秒）；同步等待完整结果，长音频耗时较长，默认 3 分钟
FORGE_ASR_TIMEOUT_MS=180000
# 注意：flash 同步版建议单段音频 ≤5 分钟，超长选区请用切片分段（流水线已支持多 clip 合并）

FORGE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 句子分析（结构化组装链）模型
FORGE_LLM_MODEL=tongyi-xiaomi-analysis-flash
# 预处理（拆句）模型；与句子分析模型分开配置，共用上面的 base URL / API Key
FORGE_PREPROCESS_MODEL=qwen3.8-flash
FORGE_LLM_API_KEY=sk-换成你的百炼Key
# 非 ollama 服务必须留空本行：ollama 专用的 reasoning_effort="none" 会被 DashScope 拒绝
FORGE_LLM_REASONING_EFFORT=
# 思考开关：qwen3.8-flash 等新模型默认开思考（思考吃 max_tokens 且无正文进度，看似卡死），云端建议关闭；ollama 不认识该字段时留空本行即可
FORGE_LLM_ENABLE_THINKING=false
# 单次 LLM 输出上限（一句一调用，单条组装链很小，留足余量即可）
FORGE_LLM_MAX_TOKENS=16000
# 一句一调用的并发上限：同时发起多少个句子的模型调用
FORGE_LLM_CONCURRENCY=10
